# GEMINI_API_KEY: Required for Gemini AI API calls.
# In Google AI Studio, this is automatically injected from user secrets.
# On local Windows PC, enter your Gemini API key here.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AI Provider Configuration (Phase 4 Step 4A)
# Provider name: 'gemini' (default)
VITE_AI_PROVIDER="gemini"
# Server-side proxy endpoint (Never expose secrets to client)
VITE_AI_API_ENDPOINT="/api/ai/command"

# ── Accounts, Free/Pro licences, admin panel (server/api.ts) ──
# Admin account, created on first start (never overwrites an existing password).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Random string, 24+ chars, used to sign login cookies and desktop licence tokens.
# (If empty, one is generated and kept in DATA_DIR so logins survive restarts.)
SESSION_SECRET=""
# Where the JSON database lives. On Render: add a persistent Disk and set this to its mount path, e.g. /var/data
DATA_DIR="./data"
